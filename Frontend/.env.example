# Server AI credentials belong in backend/.env / Render backend environment.
# Never expose AI_API_KEY or GEMINI_API_KEY through VITE_ variables.

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Backend API used by the browser. Use an HTTPS public URL in production so
# Chrome on other devices can reach it without mixed-content blocking.
VITE_API_URL="http://localhost:8000"
