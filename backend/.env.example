# Gemini Server API example. AI_API_KEY is a server-only secret.
# Never prefix it with VITE_, commit backend/.env, or place it in frontend configuration.
AI_PROVIDER=gemini
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_MODEL=gemini-3.6-flash
AI_TRANSCRIPTION_MODEL=gemini-3.5-transcribe
AI_TIMEOUT_SECONDS=180

# Ollama rollback configuration:
# AI_PROVIDER=ollama
# AI_BASE_URL=http://localhost:11434
# AI_MODEL=llama3.1:8b
# AI_TIMEOUT_SECONDS=180

# Legacy Ollama migration-window fallbacks. AI_BASE_URL and AI_MODEL take precedence.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b

# Password recovery: fixed public frontend origin, never derived from request headers.
# Use HTTPS in production. HTTP is accepted only for local development.
FRONTEND_PUBLIC_URL=https://your-career-edge-frontend.example
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Career Edge AI
SMTP_SECURITY=starttls

# Reset links expire after 20 minutes; real accounts have a 60-second DB-shared cooldown.
# Production should also rate-limit POST /auth/forgot-password at the edge/reverse proxy by IP.
# Never commit real SMTP credentials or put them in VITE_ variables.
